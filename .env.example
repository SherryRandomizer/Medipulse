# MediPulse environment configuration
# Pass values at build/run time. Never commit real secrets.
#
# flutter run \
#   --dart-define=APP_ENV=development \
#   --dart-define=FIREBASE_ENABLED=false \
#   --dart-define=AI_PROVIDER=none \
#   --dart-define=REVENUECAT_API_KEY=

APP_ENV=development
FIREBASE_ENABLED=false
AI_PROVIDER=none
OCR_PROVIDER=none
REVENUECAT_API_KEY=
ADS_ENABLED=false
SENTRY_DSN=
# Optional. When set, MediPulse sends redacted crash types and app stack frames only.
# Never put a real DSN in git. Example dart-define: --dart-define=SENTRY_DSN=https://key@host/project
GOOGLE_WEB_CLIENT_ID=
API_BASE_URL=
MEDICAL_DATA_API_KEY=
